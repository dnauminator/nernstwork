    {"id": "rutile", "label": "TiO2 (rutile)", "role": "intermediate", "phase": "solid", "composition": {"Ti": 1}},
    {"id": "Li2TiO3", "label": "Li2TiO3", "role": "intermediate", "phase": "solid", "composition": {"Ti": 1, "Li": 2}},
